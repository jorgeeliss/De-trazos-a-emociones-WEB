# Cadena de conexión a MongoDB (local o Atlas). Obligatoria: sin ella el backend termina el proceso.
MONGO_URI=mongodb://usuario:contrasena@localhost:27017/de-trazos-a-emociones

# Secreto para firmar los JWT. Obligatoria. Usa un valor largo y aleatorio, nunca el de este ejemplo.
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Vigencia del token. Opcional, por defecto "7d" (7 días). Al expirar, la app manda
# al login. Acepta formatos como "12h", "24h", "7d", "30d". Mayor valor = menos re-login.
JWT_EXPIRES_IN=7d

# Puerto del backend. Opcional, por defecto 3000.
PORT=3000

# Correos de administradores, separados por coma. Quien se registre con uno de
# estos correos queda como administrador y aprobado automáticamente; los demás
# registros quedan "pendiente" hasta que un administrador los apruebe.
# Ej.: ADMIN_EMAILS=admin@unac.edu.co,coordinador@unac.edu.co
ADMIN_EMAILS=

# Origen(es) permitido(s) para CORS, separados por coma. Opcional.
# Por defecto el Vite local. Ej.: CORS_ORIGIN=http://localhost:5173,https://miapp.com
CORS_ORIGIN=http://localhost:5173

# Servidores DNS a forzar, separados por coma. Opcional. Por defecto se usa el
# DNS del sistema. Úsalo solo si tu red no resuelve el registro SRV de Atlas
# (error "queryTxt ETIMEOUT"); por ejemplo: DNS_SERVERS=8.8.8.8,1.1.1.1
#DNS_SERVERS=8.8.8.8,1.1.1.1

# Cómo se le pide el JSON a Ollama en el análisis. Opcional, por defecto "schema".
#   schema -> usa un esquema JSON (recomendado, requiere Ollama 0.5.0 o superior).
#   json   -> usa format: "json" (para versiones de Ollama que no soportan esquema).
OLLAMA_FORMAT_MODE=schema

# Motor de análisis. Opcional, por defecto "ollama".
#   ollama -> análisis real con el modelo local.
#   mock   -> resultado SIMULADO en 2-3 s, sin Ollama (solo para probar el flujo).
# NUNCA uses "mock" en la prueba piloto ni con dibujos reales.
AI_MODE=ollama

# Modelo de visión para el análisis. Opcional, por defecto "minicpm-v".
#   minicpm-v        -> pequeño y rápido, redacción limitada.
#   llama3.2-vision  -> más grande, mejor análisis, pero más lento (requiere
#                       antes: ollama pull llama3.2-vision).
#OLLAMA_MODEL=minicpm-v

# Parámetros de generación de Ollama. Opcionales.
#   num_predict (longitud máx. de la respuesta) por defecto 4000.
#   num_ctx (tamaño del contexto) por defecto 8192.
# En equipos SIN GPU o con pocos recursos, bájalos para que el análisis no tarde
# demasiado (p. ej. 1500 y 4096). A menor valor, más rápido pero menos extenso.
#OLLAMA_NUM_PREDICT=1500
#OLLAMA_NUM_CTX=4096
